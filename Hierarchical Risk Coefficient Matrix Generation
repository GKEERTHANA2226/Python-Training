from typing import List

class Solution:
    def generateMatrix(self, n: int) -> List[str]:
        res = []
        for i in range(n):
          row = [1]*(i+1)
          for j in range(1,i):
            row[j] = prev[j-1]+prev[j]
          res.append(" ".join(map(str, row)))
          prev = row
        return res
